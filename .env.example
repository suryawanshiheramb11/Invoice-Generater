# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# These are safe to expose to the browser: the anon key only grants what your
# Row Level Security policies allow (see supabase/migrations/0001_init.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of this deployment, used for SEO metadata (Open Graph, canonical URLs)
# and as the default redirect target after email confirmation.
# Example: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# Service role key (Project Settings -> API -> service_role). Server-only — never
# prefix with NEXT_PUBLIC_, never send to the browser. Used solely by
# src/app/api/payment-proofs/[id]/verify/route.ts and scripts/verify-payment-proof.ts
# to read the private payment-proofs bucket and write back the OCR verdict. This is
# your own Supabase secret, not a third-party AI API key — no external service or
# extra signup is involved in payment-proof verification.
SUPABASE_SERVICE_ROLE_KEY=
